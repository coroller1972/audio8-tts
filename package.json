{
  "name": "audio8-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "model:download": "UV_CACHE_DIR=.cache/uv HF_HOME=.cache/huggingface uv run python scripts/download_model.py",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "UV_CACHE_DIR=.cache/uv uv run uvicorn backend.app:app --host 127.0.0.1 --port 8000",
    "build": "tsc -b && vite build",
    "start": "UV_CACHE_DIR=.cache/uv uv run uvicorn backend.app:app --host 127.0.0.1 --port 8000 --no-access-log",
    "test": "UV_CACHE_DIR=.cache/uv uv run pytest",
    "check": "tsc -b && UV_CACHE_DIR=.cache/uv uv run ruff check backend scripts tests"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "@playwright/test": "^1.56.0"
  }
}
